# --- Gizli yapılandırma ---
.env
api/.env
web/.env
model-service/.env

# --- Python ortamları ---
#
# ⚠️ TEK TEK SAYMAK YETMEDİ. Bu bölüm 30.08.2026'da yalnızca bilinen
# yolları listeliyordu; o gün `web/` altında açılan bir sanal ortam
# (`web/.venv-inceleme/`) listede olmadığı için depoya girdi ve
# **1.906 dosya** olarak izlenmeye başladı — deponun %88'i. Kural sonra
# eklendi ama `.gitignore` ZATEN İZLENEN dosyayı geri almaz; temizlik
# `git rm -r --cached` ile 02.09.2026'da yapıldı.
#
# Bu yüzden artık ad kalıbıyla ve HER DERİNLİKTE süzülüyor: yeni bir
# sanal ortam nerede açılırsa açılsın yakalanır.
.venv
.venv/
.venv*/
**/.venv*/
venv/
**/venv/
env/
**/__pycache__/
*.py[cod]

# --- Node ---
web/node_modules/
web/dist/
web/.vite/

# --- Flutter ---
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies
mobile/.flutter-plugins
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/android/.gradle/
mobile/android/local.properties

# --- Model ağırlıkları (büyük ikili dosyalar) ---
model-service/weights/

# --- Madde 9.1: Bakanlık verisi ASLA commit edilmez ---
# NOT: klasörün KENDİSİ değil, İÇERİĞİ dışlanır. Klasör dışlanırsa git
# içine hiç bakmaz ve aşağıdaki '!' kuralları çalışmaz.
data/bakanlik/*
!data/bakanlik/.gitkeep
!data/bakanlik/UYARI.md

# --- Madde 10.7: gerçek saha fotoğrafları (maskelenmemiş) ---
data/saha-foto/*
!data/saha-foto/.gitkeep

# --- Yüklenen görüntüler (çalışma zamanı) ---
api/yuklenenler/

# --- Test çıktıları ---
.pytest_cache/
tests/__pycache__/
.coverage

# --- İşletim sistemi ---
.DS_Store

# --- Görsel kaynakları (büyük PNG'ler) ---
