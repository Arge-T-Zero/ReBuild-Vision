# --- Gizli yapılandırma ---
.env
api/.env
web/.env
model-service/.env

# --- Python ortamları ---
.venv-mock/
api/.venv/
model-mock/.venv/
model-service/.venv/
api/app/__pycache__/
api/**/__pycache__/
model-mock/__pycache__/
model-service/__pycache__/

# --- Node ---
web/node_modules/
web/dist/
web/.vite/

# --- Flutter ---
mobile/build/
mobile/.dart_tool/
mobile/.flutter-plugins-dependencies

# --- Model ağırlıkları (büyük ikili dosyalar) ---
model-service/weights/

# --- Madde 9.1: Bakanlık verisi ASLA commit edilmez ---
# NOT: klasörün KENDİSİ değil, İÇERİĞİ dışlanır. Klasör dışlanırsa git
# içine hiç bakmaz ve aşağıdaki '!' kuralları çalışmaz.
data/bakanlik/*
!data/bakanlik/.gitkeep
!data/bakanlik/UYARI.md

# --- Madde 10.7: gerçek saha fotoğrafları (maskelenmemiş) ---
data/saha-foto/*
!data/saha-foto/.gitkeep

# --- Yüklenen görüntüler (çalışma zamanı) ---
api/yuklenenler/

# --- Test çıktıları ---
.pytest_cache/
tests/__pycache__/
.coverage

# --- İşletim sistemi ---
.DS_Store
