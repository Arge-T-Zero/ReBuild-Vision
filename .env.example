# ReBuild Vision — ortam değişkenleri örneği
# Bu dosyayı `.env` olarak kopyalayın ve değerleri doldurun.
# `.env` ASLA commit edilmez (.gitignore).

# --- Veri tabanı ---
# Geliştirme: PostgreSQL 17 + PostGIS 3.6, port 5433
# (port gerekçesi: docs/karar-kaydi.md K-008)
VERITABANI_URL=postgresql+asyncpg://localhost:5433/rebuild_vision

# --- Model servisi ---
# Sahte servis:   http://localhost:8090
# Gerçek servis:  http://localhost:8091
# Bu tek değişken sahte/gerçek geçişini sağlar (docs/lisans-analizi.md 3.4)
MODEL_SERVICE_URL=http://localhost:8090

# --- Güvenlik ---
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN. Üretmek için:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_GIZLI_ANAHTAR=gelistirme-icin-guvensiz-anahtar-DEGISTIRIN
JWT_GECERLILIK_DAKIKA=480

# --- Dosya depolama ---
YUKLEME_KLASORU=api/yuklenenler

# --- Web ---
IZIN_VERILEN_KAYNAKLAR=http://localhost:5173
